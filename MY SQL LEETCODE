6)Hackerrank : 
Sample Input
customers
customer_id	name	phone_number	country
1	          Alex	  9876543210	India
2	          John	  1234567890	USA
3	          David	 9876543211	India

country_codes

country	country_code
India	91
USA	1

Output
customer_id	name	phone_number
1         	Alex	+919876543210
2	         John	+11234567890
3	         David	+919876543211

SELECT 
    cu.customer_id,
    cu.name,
    CONCAT("+", cc.country_code, cu.phone_number) AS phone_number
FROM customers cu
INNER JOIN country_codes cc
    ON cu.country = cc.country
ORDER BY cu.customer_id;
